# ==============================================================================
# TOUR MANAGEMENT SYSTEM - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Site Configuration
SITE_NAME=Quản Lý Tour Du Lịch
SITE_URL=http://localhost/duan1
BASE_URL=/duan1
APP_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=tour_managementss
DB_USER=root
DB_PASS=

# Pagination
ITEMS_PER_PAGE=10

# Session
SESSION_TIMEOUT=3600
REMEMBER_ME_DAYS=30

# Currency
CURRENCY=VND
CURRENCY_SYMBOL=₫

# Date Format
DATE_FORMAT=d/m/Y
DATETIME_FORMAT=d/m/Y H:i:s
DATE_ISO_FORMAT=Y-m-d

# Password
PASSWORD_MIN_LENGTH=8
PASSWORD_HASH_ALGO=PASSWORD_BCRYPT

# File Upload
MAX_FILE_SIZE=5242880
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,pdf,xlsx,xls

# Timezone
TIMEZONE=Asia/Ho_Chi_Minh

# Roles
ROLE_ADMIN=admin
ROLE_STAFF=staff
ROLE_GUIDE=guide

# Paths (defined in PHP code)
# APP_PATH=/full/path/to/app
# VIEWS_PATH=/full/path/to/app/views
# CONTROLLERS_PATH=/full/path/to/app/controllers
# MODELS_PATH=/full/path/to/app/models
# INCLUDES_PATH=/full/path/to/app/includes
# PUBLIC_PATH=/full/path/to/app/public
# ASSETS_PATH=/full/path/to/app/public/assets

